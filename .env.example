# BMAsia Website Environment Variables
# Copy this file to .env.local and fill in the values

# PostgreSQL storage for inquiry, quotation and trial requests
DATABASE_URL=

# Gmail notification delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=

# ===================
# Google Tag Manager
# ===================
NEXT_PUBLIC_GTM_ID=GT-WRDQZP6W

# Assistant and escalation services
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
MESSENGER_HUB_URL=https://bma-messenger-hub-ooyy.onrender.com

# ===================
# Calendly
# ===================
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/bmasia/sound-innovations

# ===================
# Native demo booking
# ===================
# Keep disabled until the Google connection has been verified in production.
NATIVE_BOOKING_ENABLED=false
GOOGLE_BOOKING_CLIENT_ID=
GOOGLE_BOOKING_CLIENT_SECRET=
GOOGLE_BOOKING_REFRESH_TOKEN=
GOOGLE_BOOKING_CALENDAR_ID=primary
BOOKING_TIME_ZONE=Asia/Bangkok
BOOKING_DURATION_MINUTES=30
BOOKING_START_HOUR=10
BOOKING_END_HOUR=17
BOOKING_INTERVAL_MINUTES=30
BOOKING_LEAD_HOURS=24
BOOKING_HORIZON_DAYS=35
BOOKING_BUFFER_MINUTES=15

# Optional Microsoft Teams provider. Google Meet remains available without it.
MICROSOFT_BOOKING_TENANT_ID=
MICROSOFT_BOOKING_CLIENT_ID=
MICROSOFT_BOOKING_CLIENT_SECRET=
MICROSOFT_BOOKING_ORGANIZER_ID=

# ===================
# Site URL (for SEO)
# ===================
NEXT_PUBLIC_SITE_URL=https://bmasiamusic.com
